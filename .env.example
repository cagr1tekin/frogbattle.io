# Yerel: sunucu bu makinede
VITE_GECKOS_URL=http://localhost
VITE_GECKOS_PORT=9208

# Vercel + Render: istemci aynı origin’den /.wrtc ister (vercel.json proxy → Render). URL = kendi Vercel domain’in.
# VITE_GECKOS_URL=https://frogbattle-io.vercel.app
# VITE_GECKOS_PORT=443
# Render hostname değiştiyse vercel.json içindeki rewrite destination’ı da güncelle.
