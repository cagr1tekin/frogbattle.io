## 11. Oyun Mekaniği Sabitleri

```js
// shared/constants.js
export const MAP_RADIUS   = 2000;
export const MAP_CENTER   = 2000;
export const MAP_SIZE     = 4000;

export const BASE_SPEED      = 180;     // px/sn
export const SPEED_SCALE     = 0.001;

export const TURN_SPEED_BASE  = 4.0;   // rad/sn — başlangıç dönüş hızı
export const TURN_SPEED_SCALE = 0.003; // skor başına azalma

export const BASE_RADIUS   = 28;
export const MAX_RADIUS    = 140;
export const RADIUS_GROWTH = 0.25;

export const EAT_RATIO    = 1.1;
export const SNEAK_ANGLE_THRESHOLD = 0.26;

export const FOOD_VALUE   = 1;
export const KILL_RATIO   = 0.5;
export const FOOD_COUNT   = 400;
export const FOOD_RADIUS  = 6;

// Dil mekaniği
export const TONGUE_INTERVAL_MIN  = 1000;  // ms — en kısa bekleme
export const TONGUE_INTERVAL_MAX  = 2000;  // ms — en uzun bekleme
export const TONGUE_EXTEND_MS     = 180;   // ms — çıkma süresi
export const TONGUE_OUT_MS        = 120;   // ms — dışarıda bekleme
export const TONGUE_RETRACT_MS    = 150;   // ms — geri çekilme süresi
export const TONGUE_LENGTH_RATIO  = 1.5;   // dil uzunluğu = radius * 1.5
export const TONGUE_TIP_RADIUS    = 6;     // dil ucu çarpışma yarıçapı (px)
export const TONGUE_LOCK_ROTATION = true;  // dil dışarıdayken dönüş kilitli

// Vücut çarpışması
export const BODY_COLLISION_PENALTY  = 0.25;   // %25 skor kaybı
export const BODY_COLLISION_COOLDOWN = 2000;   // ms — hasar cooldown

// Zehir efekti
export const POISON_EFFECT_MS = 1500;   // ms — efekt süresi

// Diğer
export const CORPSE_LIFETIME = 30000;
export const CORPSE_OPACITY  = 0.7;
export const JUMP_PERIOD     = 500;
export const JUMP_AMPLITUDE  = 0.15;
export const JUMP_HEIGHT     = 8;
export const MAX_PLAYERS_PER_ROOM = 3;
export const TICK_RATE       = 20;
```

