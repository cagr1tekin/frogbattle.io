## 9. Oyun Mekaniği Sabitleri

```js
// shared/constants.js
export const MAP_RADIUS   = 2000;    // Harita yarıçapı
export const MAP_CENTER   = 2000;    // Merkez x ve y
export const MAP_SIZE     = 4000;    // MAP_RADIUS * 2

export const BASE_SPEED   = 180;     // px/saniye (delta time ile)
export const SPEED_SCALE  = 0.001;   // Büyüdükçe hız azalma

export const BASE_RADIUS  = 28;      // Başlangıç radius
export const MAX_RADIUS   = 140;     // Maksimum radius
export const RADIUS_GROWTH = 0.25;   // Score başına radius artışı

export const EAT_RATIO    = 1.1;     // Yemek için min boyut oranı
export const SNEAK_ANGLE_THRESHOLD = 0.26;  // ~15° sneak attack

export const FOOD_VALUE   = 1;       // Yem skor değeri (sabit)
export const KILL_RATIO   = 0.5;     // Öldürme bonusu çarpanı
export const FOOD_COUNT   = 400;     // Haritada sabit yem sayısı
export const FOOD_RADIUS  = 6;       // Yem görsel yarıçapı

export const CORPSE_LIFETIME = 30000; // Corpse yaşam süresi (ms)
export const CORPSE_OPACITY  = 0.7;   // Ölü kurbağa saydamlığı

export const JUMP_PERIOD    = 500;    // Zıplama döngüsü (ms)
export const JUMP_AMPLITUDE = 0.15;   // Squash & stretch şiddeti
export const JUMP_HEIGHT    = 8;      // Dikey zıplama ofseti (px)

export const MAX_PLAYERS_PER_ROOM = 3;   // Test fazı (Faz 3'te 20)
export const TICK_RATE  = 20;            // Sunucu Hz
export const BORDER_DAMAGE = 0;          // Şimdilik 0 — sınır fizik ile çözüldü
```

